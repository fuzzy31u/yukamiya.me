{
  "name": "yukamiya-portfolio-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test scripts/*.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "validate": "npm run curator:validate && npm run check && npm test && npm run build && npm run check:site",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "curator:validate": "node -e \"import('./scripts/curator/validate.mjs').then(async m=>console.log(await m.validate()))\"",
    "curator:migrate": "node scripts/curator/migrate.mjs",
    "curator:sweep": "node scripts/curator/run.mjs sweep",
    "curator:propose": "node scripts/curator/run.mjs propose"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@netlify/plugin-gatsby": "3.8.4",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.12",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "zod": "^4.6.7"
  }
}
