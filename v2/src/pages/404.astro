---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found — Yu Kamiya"
  description="Find your way back to Yu Kamiya’s selected work."
  noindex
  alternate={false}
>
  <section class="shell section">
    <header class="page-heading">
      <p class="eyebrow">404 / Not found</p>
      <h1>This page isn’t here.</h1>
      <p class="deck">
        The address may have changed. You can explore my selected work or return
        home.
      </p>
      <a class="button" href="/">
        Back home ↗
      </a>
      <p lang="ja">
        <a href="/ja/">日本語のホームへ →</a>
      </p>
    </header>
  </section>
</Base>
