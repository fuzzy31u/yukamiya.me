---
import "../styles/global.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "@fontsource/instrument-serif/latin-400.css";
import { pathFor, ui, type Locale } from "../lib/i18n";
import { getProfile } from "../lib/content";
interface Props {
  title: string;
  description: string;
  locale?: Locale;
  path?: string;
  noindex?: boolean;
  alternate?: boolean;
  article?: boolean;
}
const {
  title,
  description,
  locale = "en",
  path = "",
  noindex = false,
  alternate = true,
  article = false,
} = Astro.props;
const t = ui[locale];
const profile = await getProfile();
const canonical = new URL(
  Astro.url.pathname === "/404/" ? "/404.html" : Astro.url.pathname,
  Astro.site,
);
const preview = import.meta.env.PUBLIC_RELEASE !== "production";
const blocked = noindex || preview;
const nav = [
  ["work", t.work],
  ["speaking-writing", t.notes],
  ["about", t.about],
];
const other = locale === "en" ? "ja" : "en";
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Yu Kamiya",
  alternateName: "神谷 優",
  url: "https://yukamiya.me/",
  sameAs: profile.links.map((l) => l.url),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && (
      <>
        <link
          rel="alternate"
          hreflang="en"
          href={new URL(pathFor("en", path), Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="ja"
          href={new URL(pathFor("ja", path), Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(pathFor("en", path), Astro.site)}
        />
      </>
    )}
    {blocked && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    <meta
      property="og:image"
      content={new URL("/social-preview.png", Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Yu Kamiya — Applied AI & Technical Leadership"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@_yukamiya" />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {path === "about" && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(person).replace(/</g, "\\u003c")}
      />
    )}
  </head>
  <body>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <header class="site-header shell">
      <a
        href={pathFor(locale)}
        class="wordmark"
        aria-label={locale === "ja" ? "神谷 優 ホーム" : "Yu Kamiya home"}
      >
        Yu Kamiya<span class="wordmark-dot">.</span>
      </a>
      <nav
        class="desktop-nav"
        aria-label={
          locale === "ja" ? "メインナビゲーション" : "Main navigation"
        }
      >
        {nav.map(([slug, label]) => (
          <a
            href={pathFor(locale, slug)}
            aria-current={path.startsWith(slug) ? "page" : undefined}
          >
            {label}
          </a>
        ))}
        <a class="nav-contact" href={pathFor(locale, "contact")}>
          {t.contact} <span aria-hidden="true">↗</span>
        </a>
      </nav>
      <div class="nav-tools">
        {alternate && (
          <a
            class="locale-link"
            href={pathFor(other, path)}
            lang={other}
            hreflang={other}
            aria-label={
              locale === "en" ? "日本語に切り替える" : "Switch to English"
            }
          >
            {locale === "en" ? "日本語" : "EN"}
          </a>
        )}
        <details class="mobile-menu">
          <summary>
            {t.menu}
            <span aria-hidden="true"> +</span>
          </summary>
          <nav
            aria-label={
              locale === "ja" ? "モバイルナビゲーション" : "Mobile navigation"
            }
          >
            {nav.map(([slug, label]) => (
              <a href={pathFor(locale, slug)}>{label}</a>
            ))}
            <a href={pathFor(locale, "contact")}>{t.contact} ↗</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <a class="wordmark" href={pathFor(locale)}>
          Yu Kamiya<span class="wordmark-dot">.</span>
        </a>
        <p>{t.footer}</p>
      </div>
      <div class="footer-links">
        {profile.links.map((link) => (
          <a href={link.url}>
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Yu Kamiya</span>
        <a href={pathFor(locale, "contact")}>{t.contact}</a>
      </div>
    </footer>
  </body>
</html>
